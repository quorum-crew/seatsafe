# Generated by deploy/aws/terraform (terraform apply). Do not edit; it is
# rewritten on every apply.
ssh_user: ec2-user
ssh_key: ${ssh_key}
image: ${image}
hosts:
%{ for h in hosts ~}
%{ if h.role == "storage" ~}
  - {name: ${h.name}, role: ${h.role}, shard: ${h.shard}, node: ${h.node}, az: ${h.az}, public_ip: ${h.public_ip}, private_ip: ${h.private_ip}}
%{ else ~}
  - {name: ${h.name}, role: ${h.role}, node: ${h.node}, az: ${h.az}, public_ip: ${h.public_ip}, private_ip: ${h.private_ip}}
%{ endif ~}
%{ endfor ~}
