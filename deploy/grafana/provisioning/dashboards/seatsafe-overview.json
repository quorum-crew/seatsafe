            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(seatsafe_router_request_duration_seconds_bucket{method=\"BookSeats\"}[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(seatsafe_router_request_duration_seconds_bucket{method=\"BookSeats\"}[$__rate_interval])))",
          "legendFormat": "p99"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "C",
          "expr": "histogram_quantile(0.999, sum by (le) (rate(seatsafe_router_request_duration_seconds_bucket{method=\"BookSeats\"}[$__rate_interval])))",
          "legendFormat": "p99.9"
        }
      ]
